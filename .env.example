# Copy to .env and adjust as needed

# Host address the MCP port is published on. Every interface by default, for
# deployments behind a reverse proxy. The endpoint has no authentication of its
# own, so narrow this to 127.0.0.1 unless something in front of it does.
WITHINGS_MCP_BIND=0.0.0.0
WITHINGS_MCP_PORT=8586

# Where the OAuth tokens and the SQLite cache live ON THE HOST. The defaults are
# relative to this compose file, which is what you want for a plain `git clone`.
# Set absolute paths when something else owns the deployment directory — a
# Dockhand/Portainer stack, for instance, whose stack dir is regenerated on every
# deploy and would otherwise take your tokens with it.
#WITHINGS_MCP_CONFIG_HOST=/srv/withings-mcp/config
#WITHINGS_MCP_DATA_HOST=/srv/withings-mcp/data

TZ=Europe/Paris
WITHINGS_SYNC_DAYS=30
